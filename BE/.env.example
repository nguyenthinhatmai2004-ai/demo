API_HOST=0.0.0.0
API_PORT=8021
DATABASE_URL=sqlite:///./vnstock_v3.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VNSTOCK_QUOTE_SOURCES=VCI,KBS
VNSTOCK_FINANCE_SOURCE=VCI
TICKER_TAPE_SYMBOLS=FPT,SSI,HPG,VCB,DGC,VNM,TCB,MWG,PNJ,VIC
SCAN_SYMBOLS=FPT,HPG,SSI,VCI,VND,VCB,MBB,TCB,ACB,MWG,PNJ,MSN
PAPER_ACCOUNT_BALANCE=0
FRONTEND_TRADER_URL=http://localhost:3000
NEWS_VERIFY_TLS=true
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_MAILBOX=INBOX
GMAIL_NEWS_QUERY=long.nt1608 newer_than:2d
GMAIL_NEWS_LOOKBACK_HOURS=48
GMAIL_NEWS_SENDER=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_KEY=
DNSE_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
USE_GPT=true
GPT_MODEL=gpt-5.5
GPT_CODEX_TIMEOUT_SECONDS=1800
GPT_CODEX_WORKDIR=/app
